<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/md_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="12dp"
            tools:text="Please follow these steps to allow the app to run reliably." />

        <TextView
            android:id="@+id/md_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="12dp"
            tools:text="1. Go to Settings\n2. Select Battery\n3. Choose Unrestricted" />

        <TextView
            android:id="@+id/md_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="#D32F2F"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Note: This setting might reset after a system update." />

        <CheckBox
            android:id="@+id/md_promptCheckbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Don't show again"
            android:visibility="gone"
            tools:visibility="visible"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>
</ScrollView>
